# Copie este arquivo para .env e preencha TODOS os valores. Nunca envie o .env ao GitHub.
# Gere segredos fortes com:  openssl rand -hex 32

PORT=3000

# Senha do PostgreSQL (use apenas letras e números, por exemplo: openssl rand -hex 16)
POSTGRES_PASSWORD=

# Usado fora do Docker. Substitua SENHA pela mesma senha acima.
DATABASE_URL=postgres://escola:SENHA@localhost:5432/escola

# Segredo que assina os tokens JWT: mínimo de 32 caracteres, aleatório e exclusivo deste ambiente
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Primeiro administrador, criado por `npm run seed`
# A senha precisa ter de 10 a 72 caracteres, com letras e números
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# Número de proxies reversos confiáveis à frente da API (ex.: 1 atrás do Nginx). Vazio = nenhum
TRUST_PROXY=

# Limites de requisições (opcional)
# LOGIN_RATE_LIMIT=10      tentativas de login falhas por IP a cada 15 minutos
# GLOBAL_RATE_LIMIT=300    requisições por IP por minuto
